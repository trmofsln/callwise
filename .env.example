REDASH_URL=https://redash.example.com
# User API key with query creation/editing permissions. Server-side only.
REDDASH_API_KEY=
# Leave blank to create a query on the first successful request.
REDDASH_ADHOC_QUERY_ID=
REDASH_DATA_SOURCE_ID=70
REDASH_QUERY_NAME=adhoc-hackathon
REDASH_USER_DATA_SOURCE_ID=13
REDDASH_USER_QUERY_ID=
SQLITE_DATABASE_PATH=.data/app.sqlite
GLOBAL_CONTEXT_URL=https://erp.example.com/go/api/globalcontext/v1
# Optional X-Forwarded-For header sent to Global Context.
GLOBAL_CONTEXT_FORWARDED_FOR=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-6-luna
# Dedicated read-only offline extraction query; never reuse interactive IDs.
REDDASH_TRAINING_QUERY_ID=
BTC_MODEL_DIRECTORY=.data/best-time-to-call/models
# Separate unapproved, explicitly labelled Admin proxy experiment.
BTC_EXPERIMENT_DIRECTORY=.data/btc-operational-v3
# Session statement timeout applied to PostgreSQL Redash sources (the replica default is 5 s).
REDASH_STATEMENT_TIMEOUT=120s
REDASH_POSTGRES_SOURCE_IDS=13,21

# Sarvam AI: speech-to-text and sentiment analysis of call recordings. Server-side only.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
# Optional recording access for vendors whose URLs need credentials (JSON object of HTTP headers).
AIRTEL_RECORDING_HEADERS=
GCS_RECORDING_BEARER_TOKEN=
# Optional internal signed-URL/proxy service; {url} and {callId} are substituted.
RECORDING_PROXY_URL=
RECORDING_PROXY_HEADERS=
